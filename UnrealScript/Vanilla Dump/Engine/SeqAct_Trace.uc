Class SeqAct_Trace extends SequenceAction
    native;

var(SeqAct_Trace) Vector TraceExtent;
var(SeqAct_Trace) Vector StartOffset;
var(SeqAct_Trace) Vector EndOffset;
var(SeqAct_Trace) editconst Vector HitLocation;
var(SeqAct_Trace) editconst Object HitObject;
var(SeqAct_Trace) editconst float Distance;
var(SeqAct_Trace) bool bTraceActors;
var(SeqAct_Trace) bool bTraceWorld;

public static event function int GetObjClassVersion()
{
    return Super(SequenceObject).GetObjClassVersion() + 1;
}

