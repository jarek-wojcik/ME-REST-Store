defaultproperties
{
    bUsedWithSkeletalMesh = TRUE
    bUsedWithFracturedMeshes = TRUE
    bUsedWithStaticLighting = TRUE
    bUsedWithFluidSurfaces = TRUE
    bUsedWithDecals = TRUE
    bUsedWithMorphTargets = TRUE
}