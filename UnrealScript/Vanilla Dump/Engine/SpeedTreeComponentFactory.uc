Class SpeedTreeComponentFactory extends PrimitiveComponentFactory
    native
    editinlinenew
    collapsecategories;

var(SpeedTreeComponentFactory) editinline export SpeedTreeComponent SpeedTreeComponent;

//class default properties can be edited in the Properties tab for the class's Default__ object.
defaultproperties
{
    Begin Object Class=SpeedTreeComponent Name=SpeedTreeComponent0
        ReplacementPrimitive = None
    End Object
    SpeedTreeComponent = SpeedTreeComponent0
    CollideActors = TRUE
    BlockActors = TRUE
    BlockZeroExtent = TRUE
    BlockNonZeroExtent = TRUE
    BlockRigidBody = TRUE
}