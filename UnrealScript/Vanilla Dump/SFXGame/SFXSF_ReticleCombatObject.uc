Class SFXSF_ReticleCombatObject extends SFXSF_ReticleBase within SFXSFHandler_Reticle
    native
    transient;

//class default properties can be edited in the Properties tab for the class's Default__ object.
defaultproperties
{
    m_sFlashLinkageIdentifier = "Explosive"
    m_nFlashLayerModifier = 100
    m_bHasInTransition = TRUE
    m_bHasOutTransition = TRUE
}