public static final simulated function MaterialInstance GetMaterialOverride(int Id, bool bIsFemale, out array<CustomizableElement> Meshes, out CustomizableElement Element)
{
    local string MaterialOverrideName;
    local int idx;
    
    idx = Meshes.Find('Id', Id);
    if (idx != -1)
    {
        Element = Meshes[idx];
        MaterialOverrideName = bIsFemale ? Element.Mesh.FemaleMaterialOverride : Element.Mesh.MaleMaterialOverride;
        return MaterialInstance(FindObject(MaterialOverrideName, Class'MaterialInstance'));
    }
    return None;
}
public static final simulated function ApplyScarParameters(ScarInfo Scar, bool bIsFemale, SkeletalMeshComponent InHead)
{
    local Texture2D Emissive;
    local Texture2D Normal;
    local Texture2D Eyes;
    local string EmissiveString;
    local string NormalString;
    local string EyesString;
    local LinearColor ColorValue;
    local MaterialInstanceConstant MIC;
    local MaterialInterface Material;
    local SFXAsyncAssetLoader AssetLoader;
    local array<SFXAsyncAssetRequest> assetsToLoad;
    local Name AsyncScarGroupName;
    local SFXAsyncAssetRequest AsyncRequest;
    
    if (InHead == None)
    {
        return;
    }
    if (bIsFemale)
    {
        EmissiveString = Scar.FemaleEmissive;
        NormalString = Scar.FemaleNormal;
        EyesString = Scar.FemaleEyeEmissive;
    }
    else
    {
        EmissiveString = Scar.Emissive;
        NormalString = Scar.Normal;
        EyesString = Scar.EyeEmissive;
    }
    AsyncScarGroupName = 'ScarParameters';
    AssetLoader = BioDynamicLoadInterface(Class'Engine'.static.GetEngine()).GetAsyncAssetLoader();
    AssetLoader.ClearAsyncGroup(AsyncScarGroupName);
    AsyncRequest.AssetClass = Class'Texture2D';
    AsyncRequest.AltCookedPackageName = 'None';
    Emissive = Texture2D(FindObject(EmissiveString, Class'Texture2D'));
    if (Emissive == None)
    {
        AsyncRequest.FullAssetPath = EmissiveString;
        assetsToLoad.AddItem(AsyncRequest);
    }
    Normal = Texture2D(FindObject(NormalString, Class'Texture2D'));
    if (Normal == None)
    {
        AsyncRequest.FullAssetPath = NormalString;
        assetsToLoad.AddItem(AsyncRequest);
    }
    Eyes = Texture2D(FindObject(EyesString, Class'Texture2D'));
    if (Eyes == None)
    {
        AsyncRequest.FullAssetPath = EyesString;
        assetsToLoad.AddItem(AsyncRequest);
    }
    if (assetsToLoad.Length > 0)
    {
        AssetLoader.AsyncLoadAssets(AsyncScarGroupName, assetsToLoad);
        Class'Engine'.static.FlushAsyncLoading();
        if (!AssetLoader.IsAsyncGroupLoaded(AsyncScarGroupName))
        {
            return;
        }
    }
    if (Emissive == None)
    {
        Emissive = Texture2D(FindObject(EmissiveString, Class'Texture2D'));
    }
    if (Normal == None)
    {
        Normal = Texture2D(FindObject(NormalString, Class'Texture2D'));
    }
    if (Eyes == None)
    {
        Eyes = Texture2D(FindObject(EyesString, Class'Texture2D'));
    }
    ColorValue = Scar.Color;
    foreach InHead.Materials(Material, )
    {
        MIC = MaterialInstanceConstant(Material);
        if (MIC != None && Emissive != None && Normal != None)
        {
            MIC.SetTextureParameterValue('HED_Face_Alignment_Emis', Emissive);
            MIC.SetTextureParameterValue('HED_Face_Alignment_Norm', Normal);
            MIC.SetTextureParameterValue('EYE_Diff', Eyes);
            MIC.SetVectorParameterValue('DummyParam', ColorValue);
        }
    }
}
public static final function BioMaterialOverride FindIconicMaterialOverride(bool bIsFemale)
{
    if (bIsFemale)
    {
        return default.IconicFemaleMaterialOverride;
    }
    return None;
}
public static final simulated function SkeletalMesh GetHelmetMesh(int Id, bool bIsFemale, EHelmetPart Part, out array<CustomizableElement> Meshes, out CustomizableElement Element)
{
    local string MeshName;
    local int idx;
    
    idx = Meshes.Find('Id', Id);
    if (idx != -1)
    {
        Element = Meshes[idx];
        switch (Part)
        {
            case EHelmetPart.HelmetPart_Helmet:
                MeshName = bIsFemale ? Element.Mesh.Female : Element.Mesh.Male;
                break;
            case EHelmetPart.HelmetPart_Visor:
                MeshName = bIsFemale ? Element.Mesh.FemaleVisor : Element.Mesh.MaleVisor;
                break;
            case EHelmetPart.HelmetPart_Breather:
                MeshName = bIsFemale ? Element.Mesh.FemaleFaceplate : Element.Mesh.MaleFaceplate;
                break;
            default:
        }
        return SkeletalMesh(FindObject(MeshName, Class'SkeletalMesh'));
    }
    return None;
}
public static final simulated function SkeletalMesh GetMesh(int Id, bool bIsFemale, out array<CustomizableElement> Meshes, out CustomizableElement Element)
{
    local string MeshName;
    local int idx;
    
    idx = Meshes.Find('Id', Id);
    if (idx != -1)
    {
        Element = Meshes[idx];
        MeshName = bIsFemale ? Element.Mesh.Female : Element.Mesh.Male;
        return SkeletalMesh(FindObject(MeshName, Class'SkeletalMesh'));
    }
    return None;
}

