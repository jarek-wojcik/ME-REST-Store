Class SFXGameChoiceGUIData_Research extends SFXGameChoiceGUIData
    editinlinenew
    config(UI);

struct TechData 
{
    var SFXChoiceEntry ChoiceEntry;
    var STech stTech;
    var STreasure stTreasure;
    var Name PlotName;
    var int TechId;
    var int PlotId;
    var int TreasureId;
    var int UnlockId;
    var int nContextId;
    var int RMode;
    var int DisableId;
};

var config transient array<TechData> Tech;
var config transient array<TechData> Research;
var config stringref m_srTechTitle;
var config stringref m_srTechSubTitle;
var config stringref m_srTechAText;
var config stringref m_srTechBText;
var config stringref m_srResearchTitle;
