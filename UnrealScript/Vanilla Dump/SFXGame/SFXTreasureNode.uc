Class SFXTreasureNode extends SFXPointOfInterest
    placeable;

//class default properties can be edited in the Properties tab for the class's Default__ object.
defaultproperties
{
    Begin Object Class=SFXTreasureUseModule Name=tempTreasureModule
        m_bTargetable = TRUE
    End Object
    Modules = (tempTreasureModule)
}