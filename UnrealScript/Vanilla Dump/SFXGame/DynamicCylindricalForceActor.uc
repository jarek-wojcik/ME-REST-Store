Class DynamicCylindricalForceActor extends RB_CylindricalForceActor
    placeable;

//class default properties can be edited in the Properties tab for the class's Default__ object.
defaultproperties
{
    Begin Template Class=DrawCylinderComponent Name=DrawCylinder0
        ReplacementPrimitive = None
    End Template
    RenderComponent = DrawCylinder0
    Components = (DrawCylinder0, None)
    bNoDelete = FALSE
}