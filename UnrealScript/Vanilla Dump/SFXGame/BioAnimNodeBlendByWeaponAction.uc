Class BioAnimNodeBlendByWeaponAction extends AnimNodeBlendList
    native;

enum WeaponAnimState
{
    WeaponState_Expanded,
    WeaponState_Expanding,
    WeaponState_Collapsing,
    WeaponState_Collapsed,
};

public event function ResetForcedReplayFlag()
{
    local SFXWeapon Weapon;
    
    Weapon = SFXWeapon(SkelComponent.Outer);
    if (Weapon != None)
    {
        Weapon.bForceReplayAnimation = FALSE;
    }
}
public event function ResetInstantChangeFlag()
{
    local SFXWeapon Weapon;
    
    Weapon = SFXWeapon(SkelComponent.Outer);
    if (Weapon != None)
    {
        Weapon.bInstantExpansion = FALSE;
    }
}

