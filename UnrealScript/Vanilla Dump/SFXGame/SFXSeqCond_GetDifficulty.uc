Class SFXSeqCond_GetDifficulty extends SequenceCondition;

var(SFXSeqCond_GetDifficulty) Actor Player;

public function Activated()
{
    local SFXGRI GRI;
    
    if (Player != None)
    {
        GRI = SFXGRI(Player.WorldInfo.GRI);
        if (GRI != None)
        {
            ActivateOutputLink(int(GRI.DifficultyHandler.CurrentDifficulty));
            return;
        }
    }
    ActivateOutputLink(4);
}
public static event function int GetObjClassVersion()
{
    return Super(SequenceObject).GetObjClassVersion() + 2;
}

