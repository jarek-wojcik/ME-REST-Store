Class SFXCustomAction_EnterMountedGun extends SFXCustomAction_SingleAnim
    config(Game);

public function StartCustomAction()
{
    local Vector LookTarget;
    local Vector ToTurret;
    local SkelControlLookAt oSkelControl;
    
    ToTurret = m_oPawn.SyncPawn.location - m_oPawn.location;
    ToTurret.Z = 0.0;
    LookTarget = m_oPawn.location + Normal(ToTurret) * 1000.0;
    oSkelControl = SkelControlLookAt(m_oPawn.SyncPawn.Mesh.FindSkelControl('Shield'));
    if (oSkelControl != None)
    {
        oSkelControl.TargetLocation = LookTarget;
    }
    if (m_oPawn.IsPlayerPawn())
    {
        RotatePlayerCamToFace(LookTarget, 0.5);
    }
    else
    {
        SetFacePreciseRotation(Rotator(ToTurret), 0.200000003);
    }
    Super.StartCustomAction();
}
public function BodyStanceAnimEndNotification(AnimNodeSequence SeqNode, float PlayedTime, float ExcessTime)
{
    local Vehicle V;
    
    m_oPawn.SetPhysics(0);
    EndThisCustomAction();
    V = Vehicle(m_oPawn.SyncPawn);
    if (V != None)
    {
        V.TryToDrive(m_oPawn);
    }
}

