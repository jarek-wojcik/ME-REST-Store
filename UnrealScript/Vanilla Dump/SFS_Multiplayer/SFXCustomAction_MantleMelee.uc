Class SFXCustomAction_MantleMelee extends SFXCustomAction_PlayerMeleeBase
    config(Game);

var array<Actor> HitActors;

public function bool NotifyBump(Actor Other, Vector HitNormal)
{
    if (HitActors.Find(Other) != -1)
    {
        return FALSE;
    }
    HitActors.AddItem(Other);
    ApplyTimeline(ImpactTimeline, m_oPawn, Other);
    return Super(BioCustomAction).NotifyBump(Other, HitNormal);
}
public function StartCustomAction()
{
    Super.StartCustomAction();
    m_oPawn.Mesh.RootMotionMode = ERootMotionMode.RMM_Translate;
    m_oPawn.SetBodyStanceRootBoneAxisOption(BS_Anim, 2, 2, 2);
}
public function Breakout()
{
    local BioPlayerInput Input;
    
    Input = BioPlayerInput(BioPlayerController(m_oPawn.Controller).PlayerInput);
    if (Input.RawJoyRight > 0.800000012 || Input.RawJoyRight < -0.800000012 || Input.RawJoyUp > 0.800000012 || Input.RawJoyUp < -0.800000012)
    {
        EndThisCustomAction();
    }
}
public function ClientDoCustomActionImpact(Actor oActor, int ImpactCount, optional bool bFirstTarget, optional Vector HitLocation, optional Vector HitNormal, optional int CustomActionReactionType)
{
    local SFXModule_Timeline TimeMod;
    local BioCustomAction Action;
    
    if (m_oPawn.GetCurrentCustomAction(Action))
    {
        if (Action == Self)
        {
            TimeMod = m_oPawn.GetModule(Class'SFXModule_Timeline');
            if (TimeMod != None)
            {
                TimeMod.SpawnTimeline(ImpactTimeline, Self, m_oPawn, oActor);
            }
        }
    }
}
public function EndThisCustomAction()
{
    Super(BioCustomAction).EndThisCustomAction();
    m_oPawn.Velocity += Vector(m_oPawn.Rotation) * float(500);
}
public function StopCustomAction()
{
    Super(SFXCustomAction_ProceduralSync).StopCustomAction();
    HitActors.Length = 0;
    m_oPawn.SetBodyStanceRootBoneAxisOption(BS_Anim, 1, 1, 1);
}

