Class SFXCustomAction_SwatTurnLookAt extends SFXCustomAction_LookAtLoop
    config(Game);

var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Right_Start;
var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Right_Loop;
var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Right_End;
var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Left_Start;
var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Left_Loop;
var(SFXCustomAction_SwatTurnLookAt) BodyStance BS_Mid_Cov_Left_End;

public static event function GetUsedAnimNames(out array<Name> UsedAnims)
{
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Right_Start, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Right_Loop, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Right_End, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Left_Start, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Left_Loop, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_Mid_Cov_Left_End, UsedAnims);
    Super.GetUsedAnimNames(UsedAnims);
}
public function BodyStance GetEndBodyStanceAnim()
{
    if (m_oPawn.CoverType == ECoverType.CT_MidLevel && m_oPawn.CoverAction == ECoverAction.CA_PeekRight)
    {
        return BS_Mid_Cov_Right_End;
    }
    else
    {
        return BS_Mid_Cov_Left_End;
    }
}
public function BodyStance GetLoopBodyStanceAnim()
{
    if (m_oPawn.CoverType == ECoverType.CT_MidLevel && m_oPawn.CoverAction == ECoverAction.CA_PeekRight)
    {
        return BS_Mid_Cov_Right_Loop;
    }
    else
    {
        return BS_Mid_Cov_Left_Loop;
    }
}
public function BodyStance GetStartBodyStanceAnim()
{
    if (m_oPawn.CoverType == ECoverType.CT_MidLevel && m_oPawn.CoverAction == ECoverAction.CA_PeekRight)
    {
        return BS_Mid_Cov_Right_Start;
    }
    else
    {
        return BS_Mid_Cov_Left_Start;
    }
}
public function FlinchActionOverride()
{
    InterruptThisCustomAction();
}

