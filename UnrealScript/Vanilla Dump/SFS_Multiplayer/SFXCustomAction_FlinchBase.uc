Class SFXCustomAction_FlinchBase extends SFXCustomAction_SingleAnim
    config(Game);

var(SFXCustomAction_FlinchBase) BodyStance BS_Reaction;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionAlt;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionMidRight;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionAltMidRight;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionMidLeft;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionAltMidLeft;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionStdRight;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionAltStdRight;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionStdLeft;
var(SFXCustomAction_FlinchBase) BodyStance BS_ReactionAltStdLeft;
var(AnimControl) AnimSet AnimSet;
var(SFXCustomAction_FlinchBase) WwiseEvent CloseCallSoundPlayer;
var(SFXCustomAction_FlinchBase) WwiseEvent CloseCallImpactSoundPlayer;
var(SFXCustomAction_FlinchBase) WwiseEvent CloseCallSoundHench;
var(SFXCustomAction_FlinchBase) WwiseEvent CloseCallImpactSoundHench;
var(SFXCustomAction_FlinchBase) ECoverType CoverType;
var(SFXCustomAction_FlinchBase) ECoverAction CoverAction;

public static event function GetUsedAnimNames(out array<Name> UsedAnims)
{
    GetAnimsUsedByBodyStance(default.BS_Reaction, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionAlt, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionMidRight, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionMidLeft, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionStdRight, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionStdLeft, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionAltMidRight, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionAltMidLeft, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionAltStdRight, UsedAnims);
    GetAnimsUsedByBodyStance(default.BS_ReactionAltStdLeft, UsedAnims);
    Super.GetUsedAnimNames(UsedAnims);
}
public function StartCustomAction()
{
    m_oPawn.RegisterTemporaryAnim(AnimSet);
    CoverAction = m_oPawn.CoverAction;
    CoverType = m_oPawn.CoverType;
    Super.StartCustomAction();
}
public function BodyStance GetBodyStanceAnim()
{
    local float F;
    
    F = FRand();
    if (CoverAction == ECoverAction.CA_PeekRight)
    {
        if (CoverType == ECoverType.CT_Standing)
        {
            if (F < 0.333299994)
            {
                return BS_ReactionStdRight;
            }
            else
            {
                return BS_ReactionAltStdRight;
            }
        }
        else if (F < 0.333299994)
        {
            return BS_ReactionMidRight;
        }
        else
        {
            return BS_ReactionAltMidRight;
        }
    }
    else if (CoverAction == ECoverAction.CA_PeekLeft)
    {
        if (CoverType == ECoverType.CT_Standing)
        {
            if (F < 0.333299994)
            {
                return BS_ReactionStdLeft;
            }
            else
            {
                return BS_ReactionAltStdLeft;
            }
        }
        else if (F < 0.333299994)
        {
            return BS_ReactionMidLeft;
        }
        else
        {
            return BS_ReactionAltMidLeft;
        }
    }
    else if (CoverType == ECoverType.CT_MidLevel)
    {
        if (F < 0.333299994)
        {
            return BS_Reaction;
        }
        else
        {
            return BS_ReactionAlt;
        }
    }
}
protected function bool InternalCanDoCustomAction(BioPawn SyncPawn, bool bForced)
{
    if (m_oPawn.CoverAction == ECoverAction.CA_PeekLeft || m_oPawn.CoverAction == ECoverAction.CA_PeekRight)
    {
        return TRUE;
    }
    else if (m_oPawn.CoverType == ECoverType.CT_MidLevel)
    {
        return TRUE;
    }
    return bForced;
}
public function StopCustomAction()
{
    m_oPawn.UnregisterTemporaryAnim(AnimSet);
    Super.StopCustomAction();
}
public function FlinchActionOverride()
{
    EndThisCustomAction();
}
public function PlayImpactSound()
{
    if (m_oPawn != None && m_oPawn.IsHumanControlled() && m_oPawn.IsLocallyControlled())
    {
        m_oPawn.PlaySound(CloseCallImpactSoundPlayer);
    }
    else
    {
        m_oPawn.PlaySound(CloseCallImpactSoundHench);
    }
}
public function PlayWhizSound()
{
    if (m_oPawn != None && m_oPawn.IsHumanControlled() && m_oPawn.IsLocallyControlled())
    {
        m_oPawn.PlaySound(CloseCallSoundPlayer);
    }
    else
    {
        m_oPawn.PlaySound(CloseCallSoundHench);
    }
}

