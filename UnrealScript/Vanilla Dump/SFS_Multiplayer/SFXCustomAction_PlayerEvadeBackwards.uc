Class SFXCustomAction_PlayerEvadeBackwards extends SFXCustomAction_PlayerEvadeBase
    config(Game);

var(SFXCustomAction_PlayerEvadeBackwards) float MoveDist;

public function StartCustomAction()
{
    local Vector ToEnd2D;
    
    Super.StartCustomAction();
    ToEnd2D = GetRollDirection();
    SetReachPreciseDestination(m_oPawn.location + ToEnd2D * MoveDist);
    m_oPawn.Velocity += Vector(m_oPawn.Rotation) * float(500);
}
public function ClientDoCustomActionImpact(Actor oActor, int ImpactCount, optional bool bFirstTarget, optional Vector HitLocation, optional Vector HitNormal, optional int CustomActionReactionType)
{
    local SFXModule_Timeline TimeMod;
    local BioCustomAction Action;
    
    if (m_oPawn.GetCurrentCustomAction(Action))
    {
        if (Action == Self)
        {
            TimeMod = m_oPawn.GetModule(Class'SFXModule_Timeline');
            if (TimeMod != None)
            {
                TimeMod.SpawnTimeline(ImpactTimeline, Self, m_oPawn, oActor);
            }
        }
    }
}
protected function bool InternalCanDoCustomAction(BioPawn SyncPawn, bool bForced)
{
    if (SFXPawn_Player(m_oPawn) != None && !SFXPawn_Player(m_oPawn).bCanRoll && !bForced)
    {
        return FALSE;
    }
    return Super(BioCustomAction).InternalCanDoCustomAction(SyncPawn, bForced);
}
public function StopCustomAction()
{
    Super(SFXCustomAction_SingleAnim).StopCustomAction();
}
public function RollOverride()
{
    InterruptThisCustomAction();
}

