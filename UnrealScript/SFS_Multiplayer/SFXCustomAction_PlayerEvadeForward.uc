Class SFXCustomAction_PlayerEvadeForward extends SFXCustomAction_PlayerEvadeBase
    config(Game);

var(SFXCustomAction_PlayerEvadeForward) Vector MoveOffset;
var(SFXCustomAction_PlayerEvadeForward) float MoveDist;
var(SFXCustomAction_PlayerEvadeForward) bool bHitWallEnabled;

public function bool NotifyHitWall(Vector HitNormal, Actor Wall)
{
    local BioPlayerController oPlayer;
    
    if (!bHitWallEnabled)
    {
        return FALSE;
    }
    oPlayer = BioPlayerController(m_oPawn.Controller);
    if (oPlayer != None && oPlayer.IsLocalPlayerController())
    {
        if (oPlayer.GetGameModeDefault().TryAcquireCover(TRUE) == TRUE)
        {
            m_oPawn.bDisableAnimatedTransitions = TRUE;
            EndThisCustomAction();
        }
    }
    return Super(BioCustomAction).NotifyHitWall(HitNormal, Wall);
}
public function StartCustomAction()
{
    local Vector ToEnd2D;
    
    ToEnd2D = GetRollDirection();
    SetReachPreciseDestination(m_oPawn.location + ToEnd2D * MoveDist);
    m_oPawn.Velocity += ToEnd2D * float(500);
    SyncRotation(1.0, ToEnd2D);
    bHitWallEnabled = FALSE;
    Super.StartCustomAction();
}
public function ClientDoCustomActionImpact(Actor oActor, int ImpactCount, optional bool bFirstTarget, optional Vector HitLocation, optional Vector HitNormal, optional int CustomActionReactionType)
{
    local SFXModule_Timeline TimeMod;
    local BioCustomAction Action;
    
    if (m_oPawn.GetCurrentCustomAction(Action))
    {
        if (Action == Self)
        {
            TimeMod = m_oPawn.GetModule(Class'SFXModule_Timeline');
            if (TimeMod != None)
            {
                TimeMod.SpawnTimeline(ImpactTimeline, Self, m_oPawn, oActor);
            }
        }
    }
}
public function EndThisCustomAction()
{
    Super(BioCustomAction).EndThisCustomAction();
    m_oPawn.Velocity += Vector(m_oPawn.Rotation) * float(500);
}
protected function bool InternalCanDoCustomAction(BioPawn SyncPawn, bool bForced)
{
    if (SFXPawn_Player(m_oPawn) != None && !SFXPawn_Player(m_oPawn).bCanRoll && !bForced)
    {
        return FALSE;
    }
    return Super(BioCustomAction).InternalCanDoCustomAction(SyncPawn, bForced);
}
public function StopCustomAction()
{
    Super(SFXCustomAction_SingleAnim).StopCustomAction();
    m_oPawn.LockDesiredRotation(FALSE, FALSE);
    m_oPawn.SetRotation(m_oPawn.Controller.Rotation);
}
public function RollOverride()
{
    InterruptThisCustomAction();
}
public function SyncRotation(float Alpha, Vector ToEnd2D)
{
    local Rotator R;
    
    m_oPawn.LockDesiredRotation(FALSE, FALSE);
    m_oPawn.Mesh.RootMotionRotationMode = ERootMotionRotationMode.RMRM_Ignore;
    R = RLerp(m_oPawn.Rotation, Rotator(ToEnd2D), Alpha, TRUE);
    m_oPawn.SetRotation(R);
    m_oPawn.SetDesiredRotation(R, TRUE, FALSE, 0.0);
}
public function TurnOnHitWall()
{
    bHitWallEnabled = TRUE;
}

